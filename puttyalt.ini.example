; PuttyAlt v0.4.0 Portable Configuration
; Place this file as puttyalt.ini next to the executable

[General]
version=0.4.0
theme=dracula
font=Consolas
font_size=11
auto_update_check=1
check_interval_hours=24

[Session:default]
host=
port=22
username=
protocol=ssh
keepalive=60
auto_reconnect=1

[Workspace:default]
name=Default
sessions=

[Logging]
enabled=0
format=text
level=info
max_size=10485760
max_files=5

[Appearance]
opacity=100
inactive_opacity=90
bell_mode=system
url_underline=1
tab_position=top

[Keyboard]
new_tab=Ctrl+T
close_tab=Ctrl+W
next_tab=Ctrl+Tab
prev_tab=Ctrl+Shift+Tab
find=Ctrl+Shift+F
quick_connect=Ctrl+K
