# Auto-detect text files and normalise line endings
* text=auto

# C source
*.c text diff=c
*.h text diff=c

# CMake
*.cmake text
CMakeLists.txt text

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.md text
*.txt text

# Binary
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.svg binary
