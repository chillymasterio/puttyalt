/* PuttyAlt Windows resource file — v3.0.0 */

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,0,0
PRODUCTVERSION  3,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "PuttyAlt Project"
            VALUE "FileDescription",  "PuttyAlt - New Era SSH Terminal"
            VALUE "FileVersion",      "3.0.0"
            VALUE "InternalName",     "puttyalt"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "puttyalt.exe"
            VALUE "ProductName",      "PuttyAlt New Era"
            VALUE "ProductVersion",   "3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

/* Application icon — multi-size (16..256px) */
100 ICON "res/puttyalt.ico"

/* Application manifest — DPI-aware, visual styles */
1 RT_MANIFEST "res/puttyalt.manifest"
