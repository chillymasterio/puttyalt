# Standalone Makefile for PuttyAlt enhancement modules
# For quick testing without full CMake build

CC ?= gcc
CFLAGS = -std=c99 -Wall -Wextra -O2

PUTTYALT_SRCS = $(wildcard puttyalt_*.c)
PUTTYALT_OBJS = $(PUTTYALT_SRCS:.c=.o)

libputtyalt.a: $(PUTTYALT_OBJS)
	$(AR) rcs $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(PUTTYALT_OBJS) libputtyalt.a

.PHONY: clean
